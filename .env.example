# Copie para `.env` na raiz do projeto se quiser sobrescrever os padroes.
# O `docker compose up` funciona sem `.env`: todos os valores abaixo ja sao os defaults.

# Banco de dados (usado pelo servico `db` e pela API)
DB_NAME=evaluation
DB_USER=app
DB_PASSWORD=app

# Portas expostas no host
# Postgres usa 5433 por padrao para nao colidir com uma instalacao local em 5432.
DB_HOST_PORT=5433
API_HOST_PORT=8080
WEB_HOST_PORT=3000
